# Copy to .env.compose for Docker Compose local runs.
# Defaults keep everything local and avoid Bedrock/AWS calls.

DIALEDIN_MEDIA_STORAGE_MODE=local
DIALEDIN_LOCAL_MEDIA_UPLOAD_DIR=/app/data/uploads
DIALEDIN_PROFILE_STORAGE=json
PROFILE_RESEARCH_AUTORUN=false

# Browser-facing URL for the Next.js frontend.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000

# Existing DialedIn Django API local settings.
DIALEDIN_DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.68.101,192.168.68.102

# Landing app local placeholders. Replace with real Supabase env vars when needed.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=local-placeholder-key

# Optional AWS/Bedrock settings for research and S3/DynamoDB mode.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# MODEL=bedrock/openai.gpt-oss-20b-1:0
# DIALEDIN_MEDIA_UPLOAD_BUCKET=
# DIALEDIN_PROFILE_STORAGE=dynamodb
# DIALEDIN_PROFILE_TABLE=
# DIALEDIN_SHOT_RESULTS_TABLE=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
