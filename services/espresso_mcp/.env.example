# Same Bedrock style as PolyAIFursa
MODEL=bedrock/openai.gpt-oss-20b-1:0
AWS_REGION=us-east-1

# Use one of these AWS auth methods locally:
# 1. aws configure / AWS_PROFILE
# 2. Export temporary AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN
# 3. IAM role in deployment
# AWS_PROFILE=default

# Automatically run the Bedrock draft worker after unknown gear is captured.
PROFILE_RESEARCH_AUTORUN=false
PROFILE_RESEARCH_AUTORUN_LIMIT=1

# Search/fetch web pages before asking Bedrock to extract profile JSON.
PROFILE_RESEARCH_WEB_EVIDENCE=true

# Use Claude on Bedrock to extract messy chat replies and validate unknown machine/grinder names.
CHAT_LLM_EXTRACTION=false
CHAT_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Media upload/storage. Local mode is easiest for simulator/dev.
DIALEDIN_MEDIA_STORAGE_MODE=local
DIALEDIN_LOCAL_MEDIA_UPLOAD_DIR=data/uploads
# DIALEDIN_MEDIA_STORAGE_MODE=s3
# DIALEDIN_MEDIA_UPLOAD_BUCKET=<terraform output dialchat_media_bucket>
# DIALEDIN_MEDIA_UPLOAD_PREFIX=dialchat-media

# Optional persistent shot history. If omitted, history stays in memory.
# DIALEDIN_SHOT_RESULTS_TABLE=<terraform output shot_results_table>
# DIALEDIN_SHOT_HISTORY_STORAGE=dynamodb

# Trusted equipment profiles. DynamoDB is used by default when a table is configured.
# Set DIALEDIN_PROFILE_STORAGE=json to force checked-in JSON files instead.
# DIALEDIN_PROFILE_STORAGE=dynamodb
# DIALEDIN_PROFILE_TABLE=<terraform output equipment_profiles_table_name>
